# Example variable values for the terraform-ansible-implementation.
# Copy to terraform.tfvars and edit — terraform.tfvars is gitignored and must
# never be committed. Everything below is fictional placeholder data.

# subscription_id = "00000000-0000-0000-0000-000000000000"
# project_name    = "tfdemo"
# environment     = "demo"
# location        = "centralus"
#
# allowed_ssh_cidr = "203.0.113.25/32"  # YOUR public IP as /32 (required — no default). Find it with: curl -s ifconfig.me
# vm_size          = "Standard_B1s"
# admin_username   = "demoadmin"
# ssh_public_key_path = "~/.ssh/id_demo.pub"
