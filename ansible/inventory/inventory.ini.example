; Example Ansible inventory for the terraform-ansible-implementation.
; Copy to inventory.ini and adjust — inventory.ini is gitignored.
; All hosts are fictional RFC 1918 addresses; nothing here is reachable.

[webservers]
web01 ansible_host=10.10.1.10 ansible_user=demoadmin
web02 ansible_host=10.10.1.11 ansible_user=demoadmin

[dbservers]
db01 ansible_host=10.10.2.10 ansible_user=demoadmin

[demo:children]
webservers
dbservers

[demo:vars]
; Group-level knobs that apply to every demo host.
ansible_python_interpreter=/usr/bin/python3
